{
  "name": "@strait/sdk-node",
  "version": "0.6.2",
  "description": "Server SDK for Node: create and manage short links and send conversion events from your backend. Zero dependencies.",
  "keywords": [
    "deep-linking",
    "short-links",
    "links",
    "attribution",
    "server",
    "node"
  ],
  "license": "MIT",
  "author": "Strait Technologies",
  "homepage": "https://straitlink.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bazingga08/strait-sdk-node.git"
  },
  "bugs": {
    "url": "https://github.com/bazingga08/strait-sdk-node/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "brand": "node scripts/brand.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
